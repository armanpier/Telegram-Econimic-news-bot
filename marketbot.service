[Unit]
Description=Market Volatility & Macro News Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Telegram-Econimic-news-bot
ExecStart=/root/Telegram-Econimic-news-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
